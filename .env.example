# AnonyMus Production Environment Configuration

# Session and encryption secret key (32-byte hex/random string)
# Audit fix ANO-SEC-018: this file is committed to the repo; do NOT put a real
# production secret here. Generate one with:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_32_BYTE_HEX_VALUE

# Execution environment ('production' or 'development')
ENVIRONMENT=production

# Database URL (SQLite WAL engine via aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./anonymus.db

# Database encryption key (audit fix ANO-SEC-008): leave empty to disable
# SQLCipher (development only). In production, set to a strong passphrase.
# The key is derived via Argon2id (t=3, m=65536, p=4) per SECURITY.md.
DB_KEY=

# Tor SOCKS5 and Control Daemon configurations
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051

# Self-Hosted Pairwise Relay domain (clearnet or onion)
RELAY_DOMAIN=relay.anonymus.chat

# Boot transport mode ('relay' or 'p2p')
ANONYMUS_MODE=p2p

# Coturn TURN/STUN credentials (audit fix ANO-SEC-003): previously hardcoded
# as ``anonymus:turnpassword`` in docker-compose.yml. Generate strong values
# with:  openssl rand -hex 16
COTURN_USER=anonymus
COTURN_PASSWORD=CHANGE_ME_TO_A_RANDOM_32_BYTE_HEX_VALUE
COTURN_REALM=anonymus.chat

# Supporter badge verification key (audit fix ANO-CODE-001 / ANO-SEC-023):
# the default is the original developer key; rotate via this env var.
# SUPPORTER_BADGE_PUBLIC_KEY=base64-encoded-ed25519-public-key

# Flask session secret (audit fix ANO-SEC-006 / ANO-SEC-018): generate with
#   openssl rand -hex 32
# Must NOT be one of the placeholder values in server.py:_PLACEHOLDER_SECRETS.
FLASK_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_32_BYTE_HEX_VALUE

# Admin secret for /api/mode endpoint (audit fix ANO-SEC-024): compared with
# ``secrets.compare_digest`` (constant-time) in server.py.
# ANONYMUS_ADMIN_SECRET=generate-a-strong-secret-here
